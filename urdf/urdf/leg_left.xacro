<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="grace_leg_left">

  <xacro:arg name="prefix" default=""/>

  <xacro:macro name="leg_left" params="prefix">

    <link name="${prefix}_HFE">
      <inertial>
        <!-- <origin xyz="0.09011 -0.07951 0.00396" rpy="0. 0. ${pi/2}"/> -->
        <origin xyz="0. 0.120 0.00396" rpy="0. 0. 0."/>
        <mass value="0.4005713"/>
        <inertia ixx="0.00437" ixy="0." ixz="0." iyy="0.00015" iyz="0." izz="0.00445"/>
      </inertial>
      <visual>
        <origin xyz= "0 0 0" rpy="0 0 ${3/4*pi - 0.05}" />
        <geometry>
          <mesh filename="package://grace_description/meshes/grace_LF_HFE_visuals.obj" scale="1. 1. 1."/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0.0 0.15 0.0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="0.025" length="0.30"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}_KFE">
      <inertial>
        <!-- <origin xyz="0.08546 0.09407 -0.011" rpy="0. 0. 0."/> -->
        <origin xyz="0.0 0.127 0." rpy="0. 0. 0."/>
        <mass value="0.4023528"/>
        <inertia ixx="0.00019" ixy="0." ixz="0." iyy="0.00009" iyz="0." izz="0.00019"/>
      </inertial>
      <visual>
        <origin xyz= "0 0 0.015" rpy="0 0 ${pi/4}" />
        <geometry>
          <mesh filename="package://grace_description/meshes/grace_LF_KFE_visuals.obj" scale="1. 1. 1."/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0.10 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="0.015" length="0.10"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}_FOOT">
      <inertial>
        <!-- <origin xyz="0.03205 -0.0 -0.0" rpy="0. 0. 0."/> -->
        <origin xyz="0.0 -0.0 0.03205" rpy="0. 0. 0."/>
        <mass value="0.3656907"/>
        <inertia ixx="0.00014" ixy="0." ixz="0." iyy="0.00014" iyz="0." izz="0.00021"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 ${-pi/2} 0"/>
        <geometry>
          <mesh filename="package://grace_description/meshes/grace_LF_FOOT_visuals.obj" scale="1. 1. 1."/>
        </geometry>
      </visual>
    </link>

    <link name="${prefix}_FOOT_FINGER_01">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="0.02"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}_FOOT_FINGER_02">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="0.02"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}_FOOT_FINGER_03">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="0.02"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}_FOOT_FINGER_00">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="0.02"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}_KFE" type="revolute">
      <origin xyz="0 0.303 0" rpy="0 0 0"/>
      <parent link="${prefix}_HFE"/>
      <child link="${prefix}_KFE"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-130 *pi/180}" upper="${130 *pi/180}" effort="4800." velocity="7.4874625"/>
    </joint>

<!--     <joint name="${prefix}_FOOT" type="fixed">
      <origin xyz="0 0.17 0" rpy="${-pi/2} 0 0"/>
      <parent link="${prefix}_KFE"/>
      <child link="${prefix}_FOOT"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-16*pi/180}" upper="${16*pi/180}" effort="0" velocity="0"/>
    </joint> -->


    <joint name="${prefix}_ankle_1" type="revolute">
      <origin xyz="0 0.17 0" rpy="${-pi/2} 0 0"/>
      <parent link="${prefix}_KFE"/>
      <child link="${prefix}_fake_ankle_1"/>
      <axis xyz="1 0 0"/>
      <limit lower="${-16*pi/180}" upper="${16*pi/180}" effort="0" velocity="0"/>
    </joint>

    <link name="${prefix}_fake_ankle_1"/>

    <joint name="${prefix}_ankle_2" type="revolute">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${prefix}_fake_ankle_1"/>
      <child link="${prefix}_fake_ankle_2"/>
      <axis xyz="0 1 0"/>
      <limit lower="${-16*pi/180}" upper="${16*pi/180}" effort="0" velocity="0"/>
    </joint>

    <link name="${prefix}_fake_ankle_2"/>

    <joint name="${prefix}_FOOT" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${prefix}_fake_ankle_2"/>
      <child link="${prefix}_FOOT"/>
      <axis xyz="0 0 1"/>
    </joint>

    <joint name="${prefix}_finger_01" type="fixed">
      <origin xyz="0.0482127 0.0876079 0.04" rpy="${pi} 0 0"/>
      <parent link="${prefix}_FOOT"/>
      <child link="${prefix}_FOOT_FINGER_01"/>
    </joint>

    <joint name="${prefix}_finger_02" type="fixed">
      <origin xyz="0.0491521 -0.0884335 0.04" rpy="${pi} 0 0"/>
      <parent link="${prefix}_FOOT"/>
      <child link="${prefix}_FOOT_FINGER_02"/>
    </joint>

    <joint name="${prefix}_finger_03" type="fixed">
      <origin xyz="-0.1037888 0 0.04" rpy="${pi} 0 0"/>
      <parent link="${prefix}_FOOT"/>
      <child link="${prefix}_FOOT_FINGER_03"/>
    </joint>

    <joint name="${prefix}_finger_00" type="fixed">
      <origin xyz="0.0 0.0 0.04" rpy="${pi} 0 0"/>
      <parent link="${prefix}_FOOT"/>
      <child link="${prefix}_FOOT_FINGER_00"/>
    </joint>


  </xacro:macro>

</robot>
